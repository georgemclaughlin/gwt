{
  "include": [
    "gwtlang/__init__.py",
    "gwtlang/api.py",
    "gwtlang/__main__.py",
    "gwtlang/debugger.py",
    "gwtlang/errors.py",
    "gwtlang/expressions.py",
    "gwtlang/formatter.py",
    "gwtlang/host.py",
    "gwtlang/inspection.py",
    "gwtlang/lsp.py",
    "gwtlang/payloads.py",
    "gwtlang/service.py",
    "gwtlang/symbols.py",
    "gwtlang/typegen.py",
    "gwtlang/validation.py",
    "examples/vendor_onboarding",
    "examples/exact_pricing"
  ],
  "typeCheckingMode": "strict",
  "pythonVersion": "3.11",
  "exclude": [
    "**/__pycache__"
  ],
  "reportUnusedImport": "none",
  "reportPrivateUsage": "none"
}

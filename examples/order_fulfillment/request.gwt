PROGRAM order fulfillment request

GIVEN order is OrderRequest
  order_id: "A200"
  payment_status: "paid"
  fraud_score: 12
  expedited: true
  items: []

GIVEN order.items are OrderItem
  | sku      | quantity |
  | "widget" | 1        |
  | "gadget" | 2        |
  | "cable"  | 1        |

GIVEN inventory is InventoryState
  widget_available: 5
  gadget_available: 1
  cable_available: 5
  widget_reserved: 0
  gadget_reserved: 0
  cable_reserved: 0

GIVEN fulfillment is FulfillmentState
  requested_units: 0
  reserved_units: 0
  backordered_units: 0
  widget_reserved: 0
  gadget_reserved: 0
  cable_reserved: 0
  widget_backordered: 0
  gadget_backordered: 0
  cable_backordered: 0
  unknown_sku_count: 0
  package_count: 0
  shipping_fee: 0
  status: "new"
  reason: "new"

WHEN fulfill order from inventory into fulfillment

PROGRAM order fulfillment request

GIVEN order is OrderRequest
  order_id: "A200"
  payment_status: "paid"
  fraud_score: 12
  expedited: true
  items: []

GIVEN order.items are OrderItem
  | sku      | quantity |
  | "widget" | 1        |
  | "gadget" | 2        |
  | "cable"  | 1        |

GIVEN inventory is InventoryState
  widget_available: 5
  gadget_available: 1
  cable_available: 5
  widget_reserved: 0
  gadget_reserved: 0
  cable_reserved: 0

REQUEST fulfill order

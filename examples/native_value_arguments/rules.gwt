PROGRAM value arguments

RECORD Basket
  unit_price: decimal
  quantity: integer
  member: boolean

RECORD Quote
  total: decimal
  note: text

REQUEST quote basket
  GIVEN basket is Basket
  GIVEN quote is Quote
    total: 0.0
    note: "pending"
  WHEN quote basket into quote
  OUTPUT quote is Quote

WHEN quote <basket> into <quote>
  GIVEN basket is Basket
  AND quote is Quote
  REQUIRE basket.unit_price >= 0
  REQUIRE basket.quantity > 0
  IF basket.member
    LET total be discount (basket.unit_price * basket.quantity) at 0.1
    set quote.total to total
    label quote with "member # discount"
  ELSE
    LET total be discount (basket.unit_price * basket.quantity) at 0.0
    set quote.total to total
    label quote with "standard"

WHEN discount <amount> at <rate>
  GIVEN amount is decimal
  AND rate is decimal
  THEN returns decimal
  subtract amount * rate from amount
  RETURN amount

WHEN label <quote> with <message>
  GIVEN quote is Quote
  AND message is text
  set quote.note to message

SCENARIO quote totals keep the original unit price
GIVEN basket is Basket
  unit_price: <price>
  quantity: <quantity>
  member: <member>

REQUEST quote basket

THEN quote.total == <total>
AND quote.note == <note>
AND basket.unit_price == <price>

EXAMPLES
  | price | quantity | member | total | note                |
  | 19.95 | 2        | false  | 39.9  | "standard"          |
  | 19.95 | 2        | true   | 35.91 | "member # discount" |
  | 0.1   | 3        | true   | 0.27  | "member # discount" |
  | 0.0   | 1        | false  | 0.0   | "standard"          |

SCENARIO a discounted copy leaves the original price unchanged
GIVEN basket is Basket
  unit_price: 10.0
  quantity: 1
  member: false

WHEN discount (basket.unit_price) at 0.1

THEN basket.unit_price == 10.0

PROGRAM checkout app

DTO Customer
  member: boolean

DTO Cart
  items: list
  subtotal: number
  shipping: number
  discount: number
  total: number

DTO Order
  status: text

WHEN subtotal cart
  GIVEN cart is Cart
  THEN returns number
  set cart.subtotal to 0
  FOR item in cart.items
    add item to cart.subtotal
  RETURN cart.subtotal

WHEN shipping for subtotal
  GIVEN subtotal is number
  THEN returns number
  IF subtotal >= 100
    RETURN 0
  ELSE
    RETURN 8

WHEN member discount for subtotal
  GIVEN subtotal is number
  THEN returns number
  IF customer.member
    RETURN subtotal * 0.1
  ELSE
    RETURN 0

WHEN checkout cart
  GIVEN cart is Cart
  LET subtotal be subtotal cart
  LET shipping be shipping for subtotal
  LET discount be member discount for subtotal
  set cart.shipping to shipping
  set cart.discount to discount
  set cart.total to subtotal + shipping - discount
  set order.status to "priced"

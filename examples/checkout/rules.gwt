PROGRAM checkout app

RECORD Customer
  member: boolean

RECORD Cart
  items: list<number>
  subtotal: number
  shipping: number
  discount: number
  total: number

RECORD Order
  status: "new" | "priced"

REQUEST checkout cart
  GIVEN customer is Customer
  AND cart is Cart

  GIVEN order is Order
    status: "new"

  WHEN checkout cart for customer into order

  OUTPUT cart is Cart
  AND order is Order

  THEN order.status == "priced"

WHEN subtotal <cart>
  GIVEN cart is Cart
  THEN returns number
  set cart.subtotal to 0
  FOR item in cart.items
    add item to cart.subtotal
  RETURN cart.subtotal

WHEN shipping for <subtotal>
  GIVEN subtotal is number
  THEN returns number
  IF subtotal >= 100
    RETURN 0
  ELSE
    RETURN 8

WHEN member discount for <customer> on <subtotal>
  GIVEN customer is Customer
  AND subtotal is number
  THEN returns number
  IF customer.member
    RETURN subtotal * 0.1
  ELSE
    RETURN 0

WHEN checkout <cart> for <customer> into <order>
  GIVEN cart is Cart
  AND customer is Customer
  AND order is Order
  LET subtotal be subtotal cart
  LET shipping be shipping for subtotal
  LET discount be member discount for customer on subtotal
  set cart.shipping to shipping
  set cart.discount to discount
  set cart.total to subtotal + shipping - discount
  set order.status to "priced"

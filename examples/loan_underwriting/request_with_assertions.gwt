PROGRAM loan request

GIVEN application is LoanApplication
  credit_score: 720
  annual_income: 96000
  monthly_debt: 2800
  home_price: 360000
  down_payment: 72000
  available_cash: 90000
  late_payments: [1]
  collections: []
  bankruptcies: 0
  employment_years: 4

REQUEST underwrite loan

THEN decision.status == "approved"
AND decision.reason == "strong_application"
AND decision.risk_points == 2
AND decision.interest_rate == 6.25
AND decision.principal == 288000

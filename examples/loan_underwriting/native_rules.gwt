PROGRAM exact ratio underwriting

RECORD LoanApplication
  credit_score: decimal
  annual_income: decimal
  monthly_debt: decimal
  home_price: decimal
  down_payment: decimal
  available_cash: decimal
  late_payments: list<number>
  collections: list<number>
  bankruptcies: decimal
  employment_years: decimal

# A ratio is a pair of exact amounts, not a rounded quotient.
RECORD ExactRatio
  numerator: decimal
  denominator: decimal

RECORD LoanDecision
  principal: decimal
  dti: ExactRatio
  ltv: ExactRatio
  reserve_months: ExactRatio
  risk_points: decimal
  interest_rate: decimal
  status: "new" | "approved" | "manual_review" | "denied"
  reason: "new" | "strong_application" | "compensating_factors" | "recent_bankruptcy" | "risk_too_high"

REQUEST underwrite loan
  GIVEN application is LoanApplication

  GIVEN decision is LoanDecision
    principal: 0
    dti:
      numerator: 0
      denominator: 1
    ltv:
      numerator: 0
      denominator: 1
    reserve_months:
      numerator: 0
      denominator: 1
    risk_points: 0
    interest_rate: 0
    status: "new"
    reason: "new"

  WHEN underwrite application into decision

  OUTPUT decision is LoanDecision

  THEN decision.status != "new"
  AND decision.reason != "new"

WHEN ratios <application> into <decision>
  GIVEN application is LoanApplication
  AND decision is LoanDecision
  # Positive denominators make cross-multiplied comparisons order-preserving.
  REQUIRE application.annual_income > 0
  REQUIRE application.home_price > 0
  LET principal be application.home_price - application.down_payment
  REQUIRE principal > 0
  set decision.principal to principal
  set decision.dti.numerator to application.monthly_debt * 12
  set decision.dti.denominator to application.annual_income
  set decision.ltv.numerator to principal
  set decision.ltv.denominator to application.home_price
  set decision.reserve_months.numerator to application.available_cash - application.down_payment
  set decision.reserve_months.denominator to principal * 0.006

WHEN within <ratio> limit <limit>
  GIVEN ratio is ExactRatio
  AND limit is decimal
  THEN returns boolean
  REQUIRE ratio.denominator > 0
  RETURN ratio.numerator <= limit * ratio.denominator

WHEN covers <ratio> minimum <minimum>
  GIVEN ratio is ExactRatio
  AND minimum is decimal
  THEN returns boolean
  REQUIRE ratio.denominator > 0
  RETURN ratio.numerator >= minimum * ratio.denominator

WHEN credit <score>
  GIVEN score is decimal
  THEN returns decimal
  DECIDE
    WHEN score >= 760
      RETURN 0
    WHEN score >= 700
      RETURN 1
    WHEN score >= 660
      RETURN 2
    ELSE
      RETURN 5

WHEN dti <ratio>
  GIVEN ratio is ExactRatio
  THEN returns decimal
  REQUIRE ratio.denominator > 0
  DECIDE
    WHEN ratio.numerator <= 0.36 * ratio.denominator
      RETURN 0
    WHEN ratio.numerator <= 0.43 * ratio.denominator
      RETURN 1
    WHEN ratio.numerator <= 0.50 * ratio.denominator
      RETURN 3
    ELSE
      RETURN 6

WHEN ltv <ratio>
  GIVEN ratio is ExactRatio
  THEN returns decimal
  REQUIRE ratio.denominator > 0
  DECIDE
    WHEN ratio.numerator <= 0.80 * ratio.denominator
      RETURN 0
    WHEN ratio.numerator <= 0.90 * ratio.denominator
      RETURN 1
    WHEN ratio.numerator <= 0.97 * ratio.denominator
      RETURN 3
    ELSE
      RETURN 5

WHEN bankruptcy <count>
  GIVEN count is decimal
  THEN returns decimal
  IF count > 0
    RETURN 8
  ELSE
    RETURN 0

WHEN employment <years>
  GIVEN years is decimal
  THEN returns decimal
  IF years >= 2
    RETURN 0
  ELSE
    RETURN 2

WHEN risks <application> into <decision>
  GIVEN application is LoanApplication
  AND decision is LoanDecision
  LET credit_points be credit application.credit_score
  LET dti_points be dti decision.dti
  LET ltv_points be ltv decision.ltv
  LET bankruptcy_points be bankruptcy application.bankruptcies
  LET employment_points be employment application.employment_years
  add credit_points to decision.risk_points
  add dti_points to decision.risk_points
  add ltv_points to decision.risk_points
  add bankruptcy_points to decision.risk_points
  add employment_points to decision.risk_points

WHEN history <application> into <decision>
  GIVEN application is LoanApplication
  AND decision is LoanDecision
  FOR point in application.late_payments
    add point to decision.risk_points
  FOR point in application.collections
    add point to decision.risk_points

WHEN classify <application> into <decision>
  GIVEN application is LoanApplication
  AND decision is LoanDecision
  LET affordable be within decision.dti limit 0.43
  LET reviewable_debt be within decision.dti limit 0.50
  LET secured be within decision.ltv limit 0.90
  LET reviewable_loan be within decision.ltv limit 0.97
  LET adequate_reserves be covers decision.reserve_months minimum 3
  LET reviewable_reserves be covers decision.reserve_months minimum 1
  DECIDE
    WHEN application.bankruptcies > 0 and application.credit_score < 700
      set decision.status to "denied"
      set decision.reason to "recent_bankruptcy"
    WHEN decision.risk_points <= 4 and affordable and secured and adequate_reserves
      set decision.status to "approved"
      set decision.reason to "strong_application"
    WHEN decision.risk_points <= 8 and reviewable_debt and reviewable_loan and reviewable_reserves
      set decision.status to "manual_review"
      set decision.reason to "compensating_factors"
    ELSE
      set decision.status to "denied"
      set decision.reason to "risk_too_high"

WHEN price <decision>
  GIVEN decision is LoanDecision
  DECIDE
    WHEN decision.status == "approved" and decision.risk_points <= 2
      set decision.interest_rate to 6.25
    WHEN decision.status == "approved"
      set decision.interest_rate to 6.5
    WHEN decision.status == "manual_review"
      set decision.interest_rate to 7.25
    ELSE
      set decision.interest_rate to 0

WHEN underwrite <application> into <decision>
  GIVEN application is LoanApplication
  AND decision is LoanDecision
  set decision.principal to 0
  set decision.dti.numerator to 0
  set decision.dti.denominator to 1
  set decision.ltv.numerator to 0
  set decision.ltv.denominator to 1
  set decision.reserve_months.numerator to 0
  set decision.reserve_months.denominator to 1
  set decision.risk_points to 0
  set decision.interest_rate to 0
  set decision.status to "new"
  set decision.reason to "new"
  ratios application into decision
  risks application into decision
  history application into decision
  classify application into decision
  price decision

SCENARIO underwriting decisions
GIVEN application is LoanApplication
  credit_score: <credit_score>
  annual_income: <annual_income>
  monthly_debt: <monthly_debt>
  home_price: <home_price>
  down_payment: <down_payment>
  available_cash: <available_cash>
  late_payments: <late_payments>
  collections: <collections>
  bankruptcies: <bankruptcies>
  employment_years: <employment_years>

REQUEST underwrite loan

THEN decision.status == <status>
AND decision.reason == <reason>
AND decision.risk_points == <risk_points>
AND decision.interest_rate == <interest_rate>
AND decision.principal == <principal>

EXAMPLES
  | credit_score | annual_income | monthly_debt | home_price | down_payment | available_cash | late_payments | collections | bankruptcies | employment_years | status          | reason                 | risk_points | interest_rate | principal |
  | 780          | 120000        | 1500         | 400000     | 100000       | 140000         | []            | []          | 0            | 5                | "approved"      | "strong_application"   | 0           | 6.25          | 300000    |
  | 700          | 90000         | 3300         | 350000     | 35000        | 45000          | [1]           | []          | 0            | 1                | "manual_review" | "compensating_factors" | 8           | 7.25          | 315000    |
  | 640          | 80000         | 4200         | 300000     | 6000         | 10000          | [1, 1, 1]     | [3]         | 1            | 0                | "denied"        | "recent_bankruptcy"    | 32          | 0             | 294000    |

SCENARIO exact thresholds and reserve boundaries
GIVEN application is LoanApplication
  credit_score: <credit_score>
  annual_income: <annual_income>
  monthly_debt: <monthly_debt>
  home_price: <home_price>
  down_payment: <down_payment>
  available_cash: <available_cash>
  late_payments: <late_payments>
  collections: <collections>
  bankruptcies: <bankruptcies>
  employment_years: <employment_years>

REQUEST underwrite loan

THEN decision.status == <status>
AND decision.reason == <reason>
AND decision.risk_points == <risk_points>
AND decision.interest_rate == <interest_rate>
AND decision.principal == <principal>

EXAMPLES
  | credit_score | annual_income | monthly_debt | home_price | down_payment | available_cash | late_payments | collections | bankruptcies | employment_years | status          | reason                 | risk_points | interest_rate | principal    |
  | 780          | 120000        | 4300         | 100000     | 10000        | 11620          | []            | []          | 0            | 5                | "approved"      | "strong_application"   | 2           | 6.25          | 90000        |
  | 780          | 120000        | 4300.000001  | 100000     | 10000        | 11620          | []            | []          | 0            | 5                | "manual_review" | "compensating_factors" | 4           | 7.25          | 90000        |
  | 780          | 120000        | 4300         | 100000     | 10000        | 11619.999999   | []            | []          | 0            | 5                | "manual_review" | "compensating_factors" | 2           | 7.25          | 90000        |
  | 780          | 120000        | 4300         | 100000     | 10000        | 10540          | []            | []          | 0            | 5                | "manual_review" | "compensating_factors" | 2           | 7.25          | 90000        |
  | 780          | 120000        | 4300         | 100000     | 10000        | 10539.999999   | []            | []          | 0            | 5                | "denied"        | "risk_too_high"        | 2           | 0             | 90000        |
  | 780          | 120000        | 1000         | 100000     | 9999.999999  | 20000          | []            | []          | 0            | 5                | "manual_review" | "compensating_factors" | 3           | 7.25          | 90000.000001 |

SCENARIO undefined or reversed ratios are refused
GIVEN application is LoanApplication
  credit_score: <credit_score>
  annual_income: <annual_income>
  monthly_debt: <monthly_debt>
  home_price: <home_price>
  down_payment: <down_payment>
  available_cash: <available_cash>
  late_payments: <late_payments>
  collections: <collections>
  bankruptcies: <bankruptcies>
  employment_years: <employment_years>

REQUEST underwrite loan
THEN fails with "assertion_failed"

EXAMPLES
  | credit_score | annual_income | monthly_debt | home_price | down_payment | available_cash | late_payments | collections | bankruptcies | employment_years |
  | 780          | 0             | 100          | 100000     | 10000        | 20000          | []            | []          | 0            | 5                |
  | 780          | -1            | 100          | 100000     | 10000        | 20000          | []            | []          | 0            | 5                |
  | 780          | 120000        | 100          | 0          | 0            | 20000          | []            | []          | 0            | 5                |
  | 780          | 120000        | 100          | -1         | 0            | 20000          | []            | []          | 0            | 5                |
  | 780          | 120000        | 100          | 100000     | 100000       | 200000         | []            | []          | 0            | 5                |
  | 780          | 120000        | 100          | 100000     | 100001       | 200000         | []            | []          | 0            | 5                |

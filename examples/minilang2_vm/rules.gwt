SCENARIO MiniLang2 VM records stack trace for missing global
GIVEN source is Mini2Source
  name: "counter closure vm sample"
  text: "print(missing)"

GIVEN front_end is Mini2FrontEnd
  tokens: []
  ast_nodes: []
  token_count: 0
  ast_node_count: 0
  lexed: false
  parsed: false
  errors: []

GIVEN resolver is Mini2Resolver
  symbols: []
  symbol_count: 0
  capture_count: 0
  resolved: false
  errors: []

GIVEN bytecode is Mini2Bytecode
  instructions: []
  instruction_count: 0
  compiled: true
  errors: []

GIVEN bytecode.instructions contains a Mini2Instruction of kind get_global
  index: 1
  line: 1
  name: "missing"

GIVEN bytecode.instructions contains a Mini2Instruction of kind halt
  index: 2
  line: 1

GIVEN vm is Mini2Runtime
  globals: []
  arrays: []
  modules: []
  closures: []
  cells: []
  value_kinds: []
  stack_trace: []
  outputs: []
  last_number: 0
  instruction_count: 0
  value_kind_count: 0
  errors: []
  status: "new"

GIVEN vm.value_kinds are Mini2ValueKind
  | name       | covered |
  | "number"   | false   |
  | "string"   | false   |
  | "boolean"  | false   |
  | "null"     | false   |
  | "array"    | false   |
  | "map"      | false   |
  | "function" | false   |
  | "closure"  | false   |

GIVEN vm.stack_trace are Mini2StackFrame
  | slot | function_name | line | pc | active |
  | 1    | ""            | 0    | 0  | false  |
  | 2    | ""            | 0    | 0  | false  |

GIVEN debugger is Mini2Debugger
  enabled: true
  snapshots: []
  snapshot_count: 0
  status: "new"
  errors: []

GIVEN repl is Mini2Repl
  input_lines: []
  history: []
  outputs: []
  errors: []
  status: "new"

WHEN run bytecode on vm with debugger

THEN vm.status == "failed"
AND vm.errors == ["undefined_global_missing"]
AND vm.instruction_count == 2
AND vm.value_kind_count == 8
AND vm.outputs == []

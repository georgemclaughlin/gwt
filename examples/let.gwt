PROGRAM let

GIVEN account is
  balance: 100
  status: "open"
AND fee is 3

WHEN withdraw <amount> from <account>
  LET total be amount + fee
  REQUIRE account.status == "open"
  AND account.balance >= total
  subtract total from account.balance

WHEN withdraw 30 from account

THEN account is
  balance: 67
  status: "open"

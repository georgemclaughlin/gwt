THEN front_end.lexed == true
AND front_end.parsed == false
AND front_end.statement_count == 5
AND front_end.errors == ["missing_print_map_double", "unexpected_statement_count"]
AND runtime.status == "failed"
AND runtime.errors == ["parse_failed"]

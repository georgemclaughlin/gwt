PROGRAM typed contracts

DTO Cart
  items: list
  total: number

WHEN cart total for cart
  GIVEN cart is Cart
  THEN returns number
  RETURN cart.total

WHEN mark cart
  GIVEN cart is Cart
  LET total be cart total for cart
  set cart.total to total + 1

GIVEN cart is Cart
  items: [10, 20]
  total: 30

WHEN mark cart

THEN cart.total == 31

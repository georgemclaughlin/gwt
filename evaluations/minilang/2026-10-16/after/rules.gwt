USE "engine.gwt"

SCENARIO MiniLang map sample executes
GIVEN source is MiniSource
  name: "map sample"
  text: "let x = 10; let y = 20; fn add; if add(x,y) > 25; let nums = [1,2,3,4]; print map double"

GIVEN front_end is MiniFrontEnd
  tokens: []
  statements: []
  lists: []
  token_count: 0
  statement_count: 0
  lexed: false
  parsed: false
  errors: []

GIVEN front_end.tokens are MiniToken
  | index | kind         | lexeme   |
  | 1     | "keyword"    | "let"    |
  | 2     | "identifier" | "x"      |
  | 3     | "symbol"     | "="      |
  | 4     | "number"     | "10"     |
  | 5     | "keyword"    | "let"    |
  | 6     | "identifier" | "y"      |
  | 7     | "symbol"     | "="      |
  | 8     | "number"     | "20"     |
  | 9     | "keyword"    | "fn"     |
  | 10    | "identifier" | "add"    |
  | 11    | "symbol"     | "("      |
  | 12    | "identifier" | "a"      |
  | 13    | "symbol"     | ","      |
  | 14    | "identifier" | "b"      |
  | 15    | "symbol"     | ")"      |
  | 16    | "symbol"     | "{"      |
  | 17    | "keyword"    | "return" |
  | 18    | "identifier" | "a"      |
  | 19    | "symbol"     | "+"      |
  | 20    | "identifier" | "b"      |
  | 21    | "symbol"     | "}"      |
  | 22    | "keyword"    | "if"     |
  | 23    | "identifier" | "add"    |
  | 24    | "symbol"     | "("      |
  | 25    | "identifier" | "x"      |
  | 26    | "symbol"     | ","      |
  | 27    | "identifier" | "y"      |
  | 28    | "symbol"     | ")"      |
  | 29    | "symbol"     | ">"      |
  | 30    | "number"     | "25"     |
  | 31    | "symbol"     | "{"      |
  | 32    | "identifier" | "print"  |
  | 33    | "symbol"     | "("      |
  | 34    | "string"     | "large"  |
  | 35    | "symbol"     | ")"      |
  | 36    | "symbol"     | "}"      |
  | 37    | "keyword"    | "else"   |
  | 38    | "symbol"     | "{"      |
  | 39    | "identifier" | "print"  |
  | 40    | "symbol"     | "("      |
  | 41    | "string"     | "small"  |
  | 42    | "symbol"     | ")"      |
  | 43    | "symbol"     | "}"      |
  | 44    | "keyword"    | "let"    |
  | 45    | "identifier" | "nums"   |
  | 46    | "symbol"     | "="      |
  | 47    | "symbol"     | "["      |
  | 48    | "number"     | "1"      |
  | 49    | "symbol"     | ","      |
  | 50    | "number"     | "2"      |
  | 51    | "symbol"     | ","      |
  | 52    | "number"     | "3"      |
  | 53    | "symbol"     | ","      |
  | 54    | "number"     | "4"      |
  | 55    | "symbol"     | "]"      |
  | 56    | "identifier" | "print"  |
  | 57    | "symbol"     | "("      |
  | 58    | "identifier" | "map"    |
  | 59    | "symbol"     | "("      |
  | 60    | "identifier" | "nums"   |
  | 61    | "symbol"     | ","      |
  | 62    | "keyword"    | "fn"     |
  | 63    | "symbol"     | "("      |
  | 64    | "identifier" | "n"      |
  | 65    | "symbol"     | ")"      |
  | 66    | "symbol"     | "{"      |
  | 67    | "keyword"    | "return" |
  | 68    | "identifier" | "n"      |
  | 69    | "symbol"     | "*"      |
  | 70    | "number"     | "2"      |
  | 71    | "symbol"     | "}"      |
  | 72    | "symbol"     | ")"      |
  | 73    | "symbol"     | ")"      |

GIVEN front_end.statements contains a MiniStatement of kind let_number
  index: 1
  name: "x"
  number_value: 10

GIVEN front_end.statements contains a MiniStatement of kind let_number
  index: 2
  name: "y"
  number_value: 20

GIVEN front_end.statements contains a MiniStatement of kind fn_add
  index: 3
  name: "add"

GIVEN front_end.statements contains a MiniStatement of kind if_add_gt_print
  index: 4
  left_name: "x"
  right_name: "y"
  threshold: 25
  then_text: "large"
  else_text: "small"

GIVEN front_end.statements contains a MiniStatement of kind let_number_list
  index: 5
  name: "nums"

GIVEN front_end.statements contains a MiniStatement of kind print_map_double
  index: 6
  list_name: "nums"

GIVEN front_end.lists are MiniNumberList
  | name   | values       |
  | "nums" | [1, 2, 3, 4] |

GIVEN runtime is MiniRuntime
  bindings: []
  add_defined: false
  outputs: []
  mapped_numbers: []
  errors: []
  status: "new"

GIVEN runtime.bindings are MiniBinding
  | name   | kind    | number_value | list_values |
  | "x"    | "unset" | 0            | []          |
  | "y"    | "unset" | 0            | []          |
  | "nums" | "unset" | 0            | []          |

REQUEST run mini source

THEN front_end.lexed == true
AND front_end.parsed == true
AND front_end.token_count == 73
AND front_end.statement_count == 6
AND front_end.errors == []
AND runtime.status == "passed"
AND runtime.outputs == ["large"]
AND runtime.mapped_numbers == [2, 4, 6, 8]
AND runtime.errors == []


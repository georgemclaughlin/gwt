{
  "name": "gwt-vscode",
  "displayName": "GWT",
  "description": "VS Code language support for GWT programs.",
  "version": "0.1.0",
  "publisher": "gwt",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:gwt",
    "onDebug:gwt",
    "onCommand:gwt.debugCurrentFile",
    "onCommand:gwt.validateCurrentFile",
    "onCommand:gwt.testCurrentFile",
    "onCommand:gwt.runCurrentFile",
    "onCommand:gwt.formatCurrentFile",
    "onCommand:gwt.checkCurrentFile",
    "onCommand:gwt.profileCurrentFile",
    "onCommand:gwt.showEngineInfo"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "gwt",
        "aliases": [
          "GWT",
          "gwt"
        ],
        "extensions": [
          ".gwt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gwt",
        "scopeName": "source.gwt",
        "path": "./syntaxes/gwt.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "gwt.debugCurrentFile",
        "title": "GWT: Debug Current File"
      },
      {
        "command": "gwt.validateCurrentFile",
        "title": "GWT: Validate Current File"
      },
      {
        "command": "gwt.testCurrentFile",
        "title": "GWT: Test Current File"
      },
      {
        "command": "gwt.runCurrentFile",
        "title": "GWT: Run Current File"
      },
      {
        "command": "gwt.formatCurrentFile",
        "title": "GWT: Format Current File"
      },
      {
        "command": "gwt.checkCurrentFile",
        "title": "GWT: Check Current File"
      },
      {
        "command": "gwt.profileCurrentFile",
        "title": "GWT: Profile Execution Evidence"
      },
      {
        "command": "gwt.showEngineInfo",
        "title": "GWT: Show Engine Information"
      }
    ],
    "breakpoints": [
      {
        "language": "gwt"
      }
    ],
    "debuggers": [
      {
        "type": "gwt",
        "label": "GWT",
        "languages": [
          "gwt"
        ],
        "initialConfigurations": [
          {
            "type": "gwt",
            "request": "launch",
            "name": "Debug Current GWT File",
            "program": "${file}",
            "mode": "test",
            "json": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "GWT: Debug Current File",
            "description": "Run the current GWT file through the GWT debugger.",
            "body": {
              "type": "gwt",
              "request": "launch",
              "name": "Debug Current GWT File",
              "program": "${file}",
              "mode": "test",
              "json": false
            }
          }
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the GWT file to run.",
                "default": "${file}"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "test",
                  "run"
                ],
                "default": "test",
                "description": "Run with gwt test or gwt run."
              },
              "json": {
                "type": "boolean",
                "default": false,
                "description": "Pass --json to the GWT command."
              },
              "cwd": {
                "type": "string",
                "description": "Working directory for the debug run."
              }
            }
          }
        }
      }
    ],
    "configuration": {
      "title": "GWT",
      "properties": {
        "gwt.server.command": {
          "type": "string",
          "default": "",
          "description": "Optional command override used to start the GWT language server. Empty uses the repo-local Python server during development, falling back to gwt lsp."
        },
        "gwt.server.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Arguments passed to the GWT language server command when gwt.server.command is set."
        },
        "gwt.engine": {
          "type": "string",
          "enum": [
            "python",
            "native"
          ],
          "default": "python",
          "scope": "window",
          "description": "Language engine for diagnostics and commands. Reload the window after changing. Native mode provides diagnostics, semantic hover/definition, declaration completion, outline, formatting, and test/run. Debugging currently uses Python."
        },
        "gwt.native.command": {
          "type": "string",
          "scope": "resource",
          "default": "gwt-native",
          "description": "Explicit native executable path or PATH command. No shell or Python fallback is used."
        },
        "gwt.native.importRoot": {
          "type": "string",
          "scope": "resource",
          "default": "",
          "description": "Native import root, absolute or relative to the workspace folder. Empty uses the workspace folder, or the file parent outside a workspace."
        },
        "gwt.native.limitsFile": {
          "type": "string",
          "scope": "resource",
          "default": "",
          "description": "Execution limit JSON file for native run, profile, test, and validate. Absolute or relative to the workspace folder (file parent outside a workspace). Empty uses native defaults. Dirty open limit files are saved before execution; requires a native executable with --limits support."
        }
      }
    }
  },
  "scripts": {
    "check": "node --check extension.js && node --check native-editor.js && node --check native-tools.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "GWT checks and commands execute a configured local language tool."
    }
  }
}

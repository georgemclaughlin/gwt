{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GWT",
  "scopeName": "source.gwt",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#booleans" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#tables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.gwt",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.gwt",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.gwt",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.gwt",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.gwt",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.gwt",
          "match": "\\b(?:PROGRAM|USE|DTO|BACKGROUND|SCENARIO|EXAMPLES|GIVEN|WHEN|THEN|AND|REQUIRE|LET|IF|ELSE|FOR|RETURN)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.gwt",
          "match": "\\b(?:set|add|subtract|print)\\b"
        },
        {
          "name": "keyword.operator.word.gwt",
          "match": "\\b(?:is|returns|in|to|from|into|with|by|for|using|as|not|and|or|greater than|less than|at least|at most)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.gwt",
          "match": "\\b(?:number|text|boolean|list|any)\\b"
        },
        {
          "match": "\\bDTO\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "entity.name.type.dto.gwt"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.symbol.gwt",
          "match": "==|!=|>=|<=|>|<|\\+|-|\\*|/"
        }
      ]
    },
    "tables": {
      "patterns": [
        {
          "name": "punctuation.separator.table.gwt",
          "match": "\\|"
        },
        {
          "name": "variable.other.placeholder.gwt",
          "match": "<[A-Za-z_][A-Za-z0-9_]*>"
        }
      ]
    }
  }
}

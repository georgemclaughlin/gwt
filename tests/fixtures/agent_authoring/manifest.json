    {
      "id": "clarify-undefined-risk-policy",
      "kind": "clarify",
      "task": "Approve high-risk vendors when appropriate.",
      "requiredClarifications": [
        "What facts define high risk?",
        "Which high-risk cases, if any, are approvable?",
        "What precedence applies when approval and rejection conditions overlap?"
      ],
      "requiredConcepts": [
        ["define high risk", "high-risk threshold", "high risk threshold"],
        ["approvable", "can be approved", "approval exceptions"],
        ["precedence", "overlap", "priority"]
      ]
    },
    {
      "id": "clarify-missing-null-domain-meaning",
      "kind": "clarify",
      "task": "Treat omitted, null, unknown, and not-applicable customer identifiers correctly.",
      "requiredClarifications": [
        "Should omitted and explicit null have the same domain meaning?",
        "Are unknown and not-applicable distinct business states?",
        "Which normalized state should each boundary value produce?"
      ],
      "requiredConcepts": [
        ["omitted", "missing"],
        ["null"],
        ["unknown"],
        ["not-applicable", "not applicable"],
        ["normalized", "state"]
      ]
    },
    {
      "id": "clarify-overlapping-decision-precedence",
      "kind": "clarify",
      "task": "When an application is both previously funded and from an unfunded cohort, return the correct rejection reason.",
      "requiredClarifications": [
        "Which rejection reason has precedence when an application is both previously funded and from an unfunded cohort?",
        "Is the precedence contractual for every request or only this scenario?"
      ],
      "requiredConcepts": [
        ["precedence", "priority", "wins"],
        ["previously funded"],
        ["unfunded cohort"]
      ]
    },
    {
      "id": "clarify-decimal-rounding-policy",
      "kind": "clarify",
      "task": "Calculate the final exact price including a percentage discount and tax.",
      "requiredClarifications": [
        "At which steps should decimal values be rounded?",
        "What scale and rounding mode apply?",
        "Are discounts applied before tax?"
      ],
      "requiredConcepts": [
        ["round", "rounded"],
        ["scale", "decimal places"],
        ["rounding mode", "half up", "half even"],
        ["before tax", "tax order", "discounts applied"]
      ]
    }
  ]

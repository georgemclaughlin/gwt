{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwtlang.dev/schemas/serve-qualification.schema.json",
  "title": "GWT Serve Qualification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "ok", "engine", "program", "corpus", "checks", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "gwt.serve-qualification" },
    "ok": { "type": "boolean" },
    "engine": { "const": "asgi" },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "digest", "identityAlgorithm"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" },
        "identityAlgorithm": { "const": "gwt-program-closure-sha256-v1" }
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "name", "digest", "cases"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" },
        "cases": { "type": "integer", "minimum": 1 }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "ok", "detail", "evidence"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "ok": { "type": "boolean" },
          "detail": { "type": "string", "minLength": 1 },
          "evidence": { "type": "object" }
        }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reference", "caseId", "request", "status", "ok", "detail"],
        "properties": {
          "reference": { "type": "string", "minLength": 1 },
          "caseId": { "$ref": "#/$defs/digest" },
          "request": { "type": "string", "minLength": 1 },
          "status": { "type": "integer", "minimum": 0, "maximum": 599 },
          "ok": { "type": "boolean" },
          "detail": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.d.ts",
    "examples/**/*.ts",
    "examples/**/*.d.ts",
    "typecheck/**/*.ts"
  ]
}
